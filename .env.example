TRANSLATION_SERVICE_HOST=127.0.0.1
TRANSLATION_SERVICE_PORT=8787
TRANSLATION_SERVICE_AUTH_TOKEN=
TRANSLATION_SERVICE_MAX_TEXT_CHARS=20000
TRANSLATION_SERVICE_TIMEOUT_MS=30000

# Backends are enabled by default. Set any *_ENABLED=false to disable one.
YOUDAO_ENABLED=true
CAIYUN_ENABLED=true
BUILTIN_AI_ENABLED=true
OPENCODE_ENABLED=true

# Reuse Easydict's encrypted default credentials when the file is available.
EDICT_REUSE_EASYDICT_CREDENTIALS=true
EASYDICT_SECRET_KEYS_PATH=/media/code/tools/Easydict/Easydict/Swift/Feature/DefaultAPIKeys/EncryptedSecretKeys.plist
EASYDICT_BUNDLE_NAME=Easydict

# Explicit values override discovered Easydict credentials.
CAIYUN_TOKEN=
CAIYUN_ENDPOINT=https://api.interpreter.caiyunai.com/v1/translator
BUILTIN_AI_ENDPOINT=
BUILTIN_AI_API_KEY=
BUILTIN_AI_MODEL=glm-4-flash-250414
YOUDAO_COOKIE=

OPENCODE_BIN=opencode
OPENCODE_MODEL=
OPENCODE_DIR=/tmp
OPENCODE_TIMEOUT_MS=120000
