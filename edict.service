[Unit]
Description=Edict Chinese-English Translation Service

[Service]
Type=simple
WorkingDirectory=/media/code/tools/edict
ExecStart=/usr/bin/node /media/code/tools/edict/bin/translate-service.js serve
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
Environment=PATH=/home/bay/.opencode/bin:/home/bay/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
